# Lead-Speicher (Produktion): Supabase-Projekt "Brand OS", Tabelle aus supabase/wertavio_anfragen.sql
SUPABASE_URL=https://aegovajwkzukhvkjwiun.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Nur lokal mit `next start`: Anfragen in .data/ statt Supabase speichern (bei `next dev` automatisch)
# WERTAVIO_DATEISPEICHER=ja

# Übergabe-Weiche, siehe lib/leads/handover.ts
WERTAVIO_ZIELE=[{"id":"kollege","typ":"kollege","name":"Kollege Makler + Finanzierung","plz":["*"],"aktiv":false}]
# ja = Anfragen mit Einwilligung sofort übergeben; sonst von Hand über POST /api/leads/uebergabe
WERTAVIO_AUTO_UEBERGABE=nein
# Schlüssel für /api/leads/uebergabe
WERTAVIO_ADMIN_SCHLUESSEL=

# Weitere Quellen für POST /api/eingang, je Quelle ein eigener Schlüssel
WERTAVIO_QUELLEN={"raeumung-hamburg":""}
